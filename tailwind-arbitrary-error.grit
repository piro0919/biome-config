language js

// Tailwind の [...] に、数字の入った値をじかに書いたクラスを見つける（w-[356px]・bottom-[calc(4rem+12px)] など）。
// data-[...] や [html[...]_&]: のような、数字の無い条件の書き方は見ない
or {
  JsxString() as $s,
  JsStringLiteralExpression() as $s,
  JsTemplateChunkElement() as $s
} where {
  $s <: r"(?s).*(?:^|[\s'\"`:])[a-z][a-z0-9:-]*-\[[^\]]*[0-9][^\]]*\].*",
  register_diagnostic(span=$s, message="Tailwind の [...] に値をじかに書かない。CSS の @theme に名前を付けて使う", severity="error")
}

