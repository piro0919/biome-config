{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "linter": {
    "rules": {
      "style": {
        "noMagicNumbers": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "test/**",
        "tests/**",
        "e2e/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    }
  ]
}
